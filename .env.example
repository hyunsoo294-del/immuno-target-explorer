# TAA Immune Profiler — private by default. Do not set PUBLIC without owner approval.

# Comma-separated allowlisted emails (optional)
TAA_PROFILER_ALLOWLIST=

# Shared access token required for private mode
TAA_PROFILER_ACCESS_TOKEN=

# Local/dev only: allow entry when token unset (never enable on a public URL)
TAA_PROFILER_DEV_OPEN=1

# Explicit public mode — requires owner approval; default off
TAA_PROFILER_PUBLIC=0
